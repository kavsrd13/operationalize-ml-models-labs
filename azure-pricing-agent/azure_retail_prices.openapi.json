{
  "openapi": "3.0.3",
  "info": {
    "title": "Azure public retail prices",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://prices.azure.com"
    }
  ],
  "paths": {
    "/api/retail/prices": {
      "get": {
        "operationId": "get_retail_prices",
        "description": "Retrieve actual Azure public retail meter JSON. Filter ARM SKUs with armSkuName, NOT skuName. Discover by SKU/region/priceType before narrowing to exact product/meter. Follow NextPageLink, at most four pages.",
        "parameters": [
          {
            "name": "$filter",
            "in": "query",
            "required": true,
            "description": "Narrow OData filter; use priceType eq 'Consumption'.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            }
          },
          {
            "name": "currencyCode",
            "in": "query",
            "required": true,
            "description": "Quoted uppercase ISO currency code, e.g. 'USD'.",
            "schema": {
              "type": "string",
              "pattern": "^'[A-Z]{3}'$"
            }
          },
          {
            "name": "api-version",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "2023-01-01-preview"
              ]
            }
          },
          {
            "name": "$skip",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Actual retail pricing page; a nonempty next link means incomplete.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "currencyCode": {
                            "type": "string"
                          },
                          "armRegionName": {
                            "type": "string"
                          },
                          "location": {
                            "type": "string"
                          },
                          "meterId": {
                            "type": "string"
                          },
                          "meterName": {
                            "type": "string"
                          },
                          "productId": {
                            "type": "string"
                          },
                          "skuId": {
                            "type": "string"
                          },
                          "productName": {
                            "type": "string"
                          },
                          "skuName": {
                            "type": "string"
                          },
                          "serviceName": {
                            "type": "string"
                          },
                          "serviceId": {
                            "type": "string"
                          },
                          "serviceFamily": {
                            "type": "string"
                          },
                          "unitOfMeasure": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string"
                          },
                          "armSkuName": {
                            "type": "string"
                          },
                          "effectiveStartDate": {
                            "type": "string"
                          },
                          "reservationTerm": {
                            "type": "string"
                          },
                          "retailPrice": {
                            "type": "number"
                          },
                          "unitPrice": {
                            "type": "number"
                          },
                          "tierMinimumUnits": {
                            "type": "number"
                          },
                          "isPrimaryMeterRegion": {
                            "type": "boolean"
                          }
                        }
                      }
                    },
                    "NextPageLink": {
                      "type": "string",
                      "nullable": true
                    },
                    "BillingCurrency": {
                      "type": "string"
                    },
                    "Count": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "Items",
                    "NextPageLink",
                    "Count"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
